#!/usr/bin/env bash
set -euo pipefail

echo "==> Running bundle install..."
bundle install --quiet

case "${1:-web}" in
  web)
    echo "==> Starting Puma (web)..."
    if [ "${RACK_ENV:-development}" = "development" ]; then
      exec bundle exec rerun --background --no-notify -- bundle exec puma -C config/puma.rb
    else
      exec bundle exec puma -C config/puma.rb
    fi
    ;;
  worker)
    # YouTube changes extraction often; the pinned binary goes stale between builds.
    echo "==> Updating yt-dlp..."
    yt-dlp -U --quiet || echo "==> yt-dlp self-update failed, continuing with the bundled version"
    echo "==> Starting Sidekiq (worker)..."
    exec bundle exec sidekiq -r ./app.rb
    ;;
  poller)
    echo "==> Starting Telegram poller..."
    exec bundle exec ruby lib/bot/poller_runner.rb
    ;;
  *)
    echo "Usage: bin/start [web|worker|poller]"
    exit 1
    ;;
esac
