TELEGRAM_BOT_TOKEN=your_telegram_bot_token
OPENAI_API_KEY=your_openai_api_key
ADMIN_CHAT_ID=your_telegram_user_id
ALLOWED_CHAT_ID=
REDIS_URL=redis://redis:6379/0
PORT=3000
RACK_ENV=development

# Media longer than this asks for confirmation before it is transcribed
MEDIA_CONFIRM_MINUTES=30
# Model used for the final summary (the per-part notes always use gpt-4o-mini)
SUMMARY_MODEL=gpt-4o
